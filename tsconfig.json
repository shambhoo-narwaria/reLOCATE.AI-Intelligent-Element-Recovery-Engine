{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "outDir": "./.workspace/dist",
    "rootDir": ".",
    "declaration": true
  },
  "exclude": [".workspace", "node_modules"]
}
